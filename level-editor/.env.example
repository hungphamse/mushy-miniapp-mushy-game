# Server-only API/auth/cron env vars. Never expose these with a VITE_ prefix.
LEVEL_EDITOR_SUPABASE_URL=https://your-project-ref.supabase.co
LEVEL_EDITOR_SUPABASE_ANON_KEY=your-publishable-or-anon-key
LEVEL_EDITOR_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
LEVEL_EDITOR_OWNER_USER_IDS=
LEVEL_EDITOR_OWNER_EMAILS=

# Vercel sends this as Authorization: Bearer <CRON_SECRET> for scheduled cron calls.
# Manual backfill calls must send the same Authorization header.
CRON_SECRET=replace-with-a-random-secret-at-least-16-chars
