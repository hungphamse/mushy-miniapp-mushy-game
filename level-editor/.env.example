VITE_LEVEL_EDITOR_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_LEVEL_EDITOR_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Comma-separated owner allowlists. Prefer user IDs when possible.
# These are client-visible in the Vite app and only gate the editor UI.
# Future API routes must repeat owner checks with server-only env vars.
VITE_LEVEL_EDITOR_OWNER_USER_IDS=
VITE_LEVEL_EDITOR_OWNER_EMAILS=

# Server-only API/cron env vars. Never expose these with a VITE_ prefix.
LEVEL_EDITOR_SUPABASE_URL=https://your-project-ref.supabase.co
LEVEL_EDITOR_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
LEVEL_EDITOR_OWNER_USER_IDS=
LEVEL_EDITOR_OWNER_EMAILS=

# Vercel sends this as Authorization: Bearer <CRON_SECRET> for scheduled cron calls.
# Manual backfill calls must send the same Authorization header.
CRON_SECRET=replace-with-a-random-secret-at-least-16-chars
